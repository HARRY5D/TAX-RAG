# ==================== Google Gemini (Section Verifier) ====================
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_VERIFY_ENABLED=true

# ==================== LangSmith ====================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=Tax RAG

# ==================== App Config ====================
APP_NAME=FinAssist AI
APP_VERSION=1.0.0
DEBUG=false

# ==================== Model Config ====================
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
LLM_TEMPERATURE=0.1

# ==================== Ollama (local offline LLM) ====================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_FALLBACK_MODEL=deepseek-coder:6.7b

# ==================== FAISS ====================
FAISS_INDEX_PATH=vectordb/faiss_index
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5

# ==================== Data Paths ====================
RAW_PDF_DIR=data/raw
CURATED_DIR=data/curated
PROCESSED_DIR=processed

# ==================== API ====================
API_HOST=0.0.0.0
API_PORT=8000
